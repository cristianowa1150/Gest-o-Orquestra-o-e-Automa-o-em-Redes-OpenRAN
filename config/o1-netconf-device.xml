//Exemplo de requisição NETCONF via O1 enviada pelo SDNC do SMO
//para ajustar parâmetros operacionais da O-DU:



<rpc message-id="101" xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <edit-config>
    <target>
      <running/>
    </target>
    <config>
      <o-ran-processing-element xmlns="urn:o-ran:components:1.0">
        <ru-elements>
          <name>O-RU-01</name>
          <bandwidth>
            <bandwidth-mhz>40</bandwidth-mhz>
          </bandwidth>
        </ru-elements>
      </o-ran-processing-element>
    </config>
  </edit-config>
</rpc>